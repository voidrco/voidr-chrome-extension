{
  "manifest_version": 3,
  "name": "Voidr Testing Assistant",
  "version": "1.0.3",
  "description": "Record Loop baselines, test sessions, and linked Voidr captures",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest",
    "cookies",
    "debugger",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.voidr.co/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Voidr Testing Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.voidr.co/*"
      ],
      "js": [
        "content/auth-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.voidr.co/*"
      ],
      "js": [
        "content/auth-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
